    "docs/auto-say.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuWeiZhi/dsh-whale-widget.git"
  },
  "bugs": {
    "url": "https://github.com/TuWeiZhi/dsh-whale-widget/issues"
  },
  "homepage": "https://github.com/TuWeiZhi/dsh-whale-widget#readme",
  "dsh": {
